<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: CC0-1.0
     Independently constructed File Viewer BPMN demo. No issue attachment content. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_Order" targetNamespace="https://file-viewer.app/examples/bpmn">
  <bpmn:process id="Process_Order" name="Review an order" isExecutable="false">
    <bpmn:startEvent id="Start" name="Order received" />
    <bpmn:userTask id="Review" name="Review order" />
    <bpmn:exclusiveGateway id="Decision" name="Approved?" default="Rejected" />
    <bpmn:serviceTask id="Dispatch" name="Dispatch order" />
    <bpmn:endEvent id="Complete" name="Complete" />
    <bpmn:endEvent id="Cancelled" name="Cancelled" />
    <bpmn:sequenceFlow id="Received" sourceRef="Start" targetRef="Review" />
    <bpmn:sequenceFlow id="Reviewed" sourceRef="Review" targetRef="Decision" />
    <bpmn:sequenceFlow id="Approved" name="Yes" sourceRef="Decision" targetRef="Dispatch" />
    <bpmn:sequenceFlow id="Sent" sourceRef="Dispatch" targetRef="Complete" />
    <bpmn:sequenceFlow id="Rejected" name="No" sourceRef="Decision" targetRef="Cancelled" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Order" name="Order review">
    <bpmndi:BPMNPlane id="Plane_Order" bpmnElement="Process_Order">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="80" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Review_di" bpmnElement="Review">
        <dc:Bounds x="170" y="100" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Decision_di" bpmnElement="Decision" isMarkerVisible="true">
        <dc:Bounds x="350" y="115" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="342" y="78" width="70" height="20" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Dispatch_di" bpmnElement="Dispatch">
        <dc:Bounds x="460" y="100" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Complete_di" bpmnElement="Complete">
        <dc:Bounds x="640" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Cancelled_di" bpmnElement="Cancelled">
        <dc:Bounds x="357" y="272" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Received_di" bpmnElement="Received">
        <di:waypoint x="116" y="140" /><di:waypoint x="170" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Reviewed_di" bpmnElement="Reviewed">
        <di:waypoint x="290" y="140" /><di:waypoint x="350" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Approved_di" bpmnElement="Approved">
        <di:waypoint x="400" y="140" /><di:waypoint x="460" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Sent_di" bpmnElement="Sent">
        <di:waypoint x="580" y="140" /><di:waypoint x="640" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Rejected_di" bpmnElement="Rejected">
        <di:waypoint x="375" y="165" /><di:waypoint x="375" y="272" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
